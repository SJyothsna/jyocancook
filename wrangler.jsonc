{
  "name": "jyocancook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/auth/*",
      "/admin",
      "/admin/*",
      "/api/admin/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "GITHUB_OWNER": "REPLACE_WITH_GITHUB_USERNAME",
    "GITHUB_REPO": "jyocancook",
    "GITHUB_BRANCH": "main",
    "GITHUB_OAUTH_CLIENT_ID": "REPLACE_WITH_GITHUB_OAUTH_CLIENT_ID",
    "ALLOWED_GITHUB_USER_ID": "REPLACE_WITH_NUMERIC_GITHUB_USER_ID"
  }
}
