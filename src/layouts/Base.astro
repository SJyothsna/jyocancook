---
import '../styles/global.css';
import { Menu, Search } from '@lucide/astro';
import { menu } from '../lib/data';

const {
  title = 'Homemade Indian Recipes',
  description = 'Discover authentic Indian dishes, everyday meals and family favourites at JyoCanCook.',
  image = '/images/recipes/andhra-chicken-curry.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// Active nav item: the matching link, or "Recipes" on category/tag pages that have no link of their own.
const path = Astro.url.pathname;
const matches = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const hasMatch = menu.some((item) => matches(item.href));
const isActive = (href: string) =>
  hasMatch ? matches(href) : href === '/recipes/' && (path.startsWith('/category/') || path.startsWith('/tag/'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={`${title} | JyoCanCook`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site).toString()} />
    <title>{title} | JyoCanCook</title>
    <slot name="head" />
  </head>
  <body>
    <header>
      <div class="topbar">
        <div class="container topline">
          <a class="logo" href="/" aria-label="JyoCanCook - Home">
            <img class="logo-img" src="/images/logo.png" alt="" width="64" height="64" />
            <div class="logo-text">
              <span>JyoCanCook</span>
              <small>Homemade Recipes</small>
            </div>
          </a>

          <form class="top-search" action="/search/" method="get" role="search">
            <input
              aria-label="Search recipes, ingredients, or tags"
              name="q"
              placeholder="Search recipes, ingredients, or tags..."
              required
            />
            <button type="submit" aria-label="Search">
              <Search size={20} aria-hidden="true" />
            </button>
          </form>

        </div>
      </div>

      <div class="nav-shell">
        <div class="container">
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
            <span>Browse categories</span>
            <Menu size={18} aria-hidden="true" />
          </button>
          <nav class="nav" id="site-nav" aria-label="Main navigation">
            {menu.map((item) => (
              <a
                href={item.href}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div>
          <span class="logo"><img class="logo-img" src="/images/logo.png" alt="" width="48" height="48" />JyoCanCook</span>
          <p class="muted">Made with love, shared with joy. Discover authentic Indian dishes.</p>
        </div>
        <div>
          <a href="/recipes/">All Recipes</a> · <a href="/about/">About</a> · <a href="/search/">Search</a>
        </div>
        <small class="muted">© {new Date().getFullYear()} JyoCanCook. All rights reserved.</small>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var t = document.querySelector('.nav-toggle'), n = document.getElementById('site-nav');
        if (!t || !n) return;
        t.addEventListener('click', function () {
          var open = n.classList.toggle('open');
          t.setAttribute('aria-expanded', String(open));
        });
      })();
    </script>
  </body>
</html>
