---
import Base from '../../layouts/Base.astro';import RecipeCard from '../../components/RecipeCard.astro';import {recipes,subcategoryName} from '../../lib/data';
const subcategories=[...new Set(recipes.flatMap(r=>r.subcategories??[]))];
---
<Base title="All Recipes"><div class="container section"><span class="eyebrow">Recipe collection</span><h1>Find your next favourite</h1><p class="muted">Browse our recipes or filter by subcategory and name.</p><div class="filterbar"><input id="filter-text" placeholder="Filter recipes by name or ingredient..." aria-label="Filter recipes"/></div><div id="subcategory-chips" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px" role="group" aria-label="Filter by subcategory"><button type="button" class="tag-chip tag-chip-selected" data-subcategory="" aria-pressed="true">All</button>{subcategories.map(s=><button type="button" class="tag-chip" data-subcategory={s} aria-pressed="false">{subcategoryName(s)}</button>)}</div><div class="cards" id="recipe-list">{recipes.map(r=><div data-title={r.title.toLowerCase()} data-ingredients={r.ingredients.map(x=>x.name).join(' ').toLowerCase()} data-subcategory={(r.subcategories??[]).join(',')}><RecipeCard recipe={r}/></div>)}</div><p class="empty hidden" id="filter-empty">No recipes match your filters.</p><p class="muted" style="margin-top:20px"><span id="recipe-count">{recipes.length}</span> recipes shown</p></div><script>const text=document.querySelector<HTMLInputElement>('#filter-text')!;const chips=[...document.querySelectorAll<HTMLButtonElement>('#subcategory-chips .tag-chip')];const items=[...document.querySelectorAll<HTMLElement>('#recipe-list > div')];let activeSub='';function filter(){let n=0;const q=text.value.toLowerCase().trim();for(const el of items){const ok=(!q||`${el.dataset.title} ${el.dataset.ingredients}`.includes(q))&&(!activeSub||(el.dataset.subcategory??'').split(',').includes(activeSub));el.classList.toggle('hidden',!ok);if(ok)n++}document.querySelector('#recipe-count')!.textContent=String(n);document.querySelector('#filter-empty')!.classList.toggle('hidden',n>0)}chips.forEach(chip=>chip.addEventListener('click',()=>{const v=chip.dataset.subcategory??'';activeSub=v!==''&&activeSub===v?'':v;chips.forEach(c=>{const on=c.dataset.subcategory===activeSub;c.classList.toggle('tag-chip-selected',on);c.setAttribute('aria-pressed',String(on))});filter()}));text.addEventListener('input',filter);const initialSub=new URLSearchParams(location.search).get('subcategory');if(initialSub)chips.find(c=>c.dataset.subcategory===initialSub)?.click();</script></Base>
