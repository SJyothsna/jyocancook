---
import Base from '../../layouts/Base.astro';import RecipeCard from '../../components/RecipeCard.astro';import {recipes,categories,tags} from '../../lib/data';
---
<Base title="All Recipes"><div class="container section"><span class="eyebrow">Recipe collection</span><h1>Find your next favourite</h1><p class="muted">Browse our recipes or filter by category, tag and name.</p><div class="filterbar"><input id="filter-text" placeholder="Filter recipes by name or ingredient..." aria-label="Filter recipes"/><select id="filter-category" aria-label="Filter by category"><option value="">All categories</option>{categories.map(c=><option value={c.slug}>{c.name}</option>)}</select><select id="filter-tag" aria-label="Filter by tag"><option value="">All tags</option>{tags.map(t=><option value={t}>{t}</option>)}</select></div><div class="cards" id="recipe-list">{recipes.map(r=><div data-title={r.title.toLowerCase()} data-ingredients={r.ingredients.map(x=>x.name).join(' ').toLowerCase()} data-category={r.category} data-tags={r.tags.join('|').toLowerCase()}><RecipeCard recipe={r}/></div>)}</div><p class="empty hidden" id="filter-empty">No recipes match your filters.</p><p class="muted" style="margin-top:20px"><span id="recipe-count">{recipes.length}</span> recipes shown</p></div><script>const text=document.querySelector<HTMLInputElement>('#filter-text')!;const cat=document.querySelector<HTMLSelectElement>('#filter-category')!;const tag=document.querySelector<HTMLSelectElement>('#filter-tag')!;const items=[...document.querySelectorAll<HTMLElement>('#recipe-list > div')];function filter(){let n=0;for(const el of items){const q=text.value.toLowerCase().trim();const ok=(!q||`${el.dataset.title} ${el.dataset.ingredients}`.includes(q))&&(!cat.value||cat.value===el.dataset.category)&&(!tag.value||el.dataset.tags?.split('|').includes(tag.value.toLowerCase()));el.classList.toggle('hidden',!ok);if(ok)n++}document.querySelector('#recipe-count')!.textContent=String(n);document.querySelector('#filter-empty')!.classList.toggle('hidden',n>0)}[text,cat,tag].forEach(el=>el.addEventListener('input',filter));</script></Base>
