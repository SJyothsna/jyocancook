---
import Base from '../../layouts/Base.astro';
import { recipes, categoryName, type Recipe } from '../../lib/data';
import { formatQty } from '../../lib/fractions';
import { stepBlocks, unitLabel } from '../../lib/recipe-text';
import { ArrowUpRight, Clock, Flame, Heart, Lightbulb, Printer, Star, Users, Utensils, Zap } from '@lucide/astro';

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

const { recipe } = Astro.props as { recipe: Recipe };

// Calculate similar recipes based on category, diet, and shared tags
const recipeTagSet = new Set((recipe.tags || []).map((t) => t.toLowerCase()));
const scored = recipes
  .filter((x) => x.slug !== recipe.slug)
  .map((x) => {
    let score = 0;
    if (x.category === recipe.category) score += 3;
    if (x.diets.some((d) => recipe.diets.includes(d))) score += 1;
    (x.tags || []).forEach((t) => {
      if (recipeTagSet.has(t.toLowerCase())) score += 2;
    });
    return { recipe: x, score };
  })
  .sort((a, b) => b.score - a.score);

const similarRecipes = scored
  .filter((item) => item.score > 0)
  .slice(0, 3)
  .map((item) => item.recipe);

const similarSlugSet = new Set(similarRecipes.map((r) => r.slug));

// Latest recipes (excluding current and already displayed similar recipes)
const latestRecipes = recipes
  .filter((x) => x.slug !== recipe.slug && !similarSlugSet.has(x.slug))
  .slice(0, 3);

function getYouTubeEmbedUrl(url?: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu.be')) {
      const id = u.pathname.slice(1);
      return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
    }
    if (u.hostname.includes('youtube.com')) {
      if (u.pathname.startsWith('/embed/')) {
        return `https://www.youtube-nocookie.com${u.pathname}`;
      }
      if (u.pathname.startsWith('/shorts/')) {
        const id = u.pathname.replace('/shorts/', '');
        return id ? `https://www.youtube-nocookie.com/embed/${id}` : null;
      }
      const v = u.searchParams.get('v');
      return v ? `https://www.youtube-nocookie.com/embed/${v}` : null;
    }
  } catch {}
  return null;
}

const youtubeEmbedUrl = getYouTubeEmbedUrl(recipe.youtubeUrl);

// The category chip is always shown, so a tag that repeats the category is left out.
const categoryLabel = categoryName(recipe.category).trim().toLowerCase();
const displayTags = recipe.tags.filter((tag) => {
  const t = tag.trim().toLowerCase();
  return t !== categoryLabel && t !== recipe.category.toLowerCase();
});

// "Homemade Sambar Recipe with Toor Dal and Vegetables" -> "Homemade Sambar" for the instructions heading.
const shortTitle =
  recipe.title.replace(/\s*\([^)]*\)/g, '').split(/\s+recipe\b/i)[0].split(/\s+with\s+/i)[0].trim() || recipe.title;

// A step titled "Optional: ..." keeps its wording and gets an "Optional" label.
const displaySteps = recipe.steps.map((s) => {
  const m = s.title.match(/^\s*optional\s*[:\-\u2013\u2014]\s*(.+)$/i);
  return m ? { ...s, title: m[1].trim(), optional: true } : { ...s, optional: false };
});

// Group ingredients by section if sections exist
const ingredientSections: { title?: string; items: typeof recipe.ingredients }[] = [];
recipe.ingredients.forEach((ing) => {
  const secTitle = ing.section?.trim() || '';
  const lastSec = ingredientSections[ingredientSections.length - 1];
  if (lastSec && (lastSec.title || '') === secTitle) {
    lastSec.items.push(ing);
  } else {
    ingredientSections.push({ title: secTitle || undefined, items: [ing] });
  }
});

const structured = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.title,
  description: recipe.description,
  image: [new URL(recipe.image, Astro.site).toString()],
  recipeYield: String(recipe.servings),
  prepTime: `PT${recipe.prepTime}M`,
  cookTime: `PT${recipe.cookTime}M`,
  recipeCategory: categoryName(recipe.category),
  keywords: recipe.tags.join(', '),
  recipeIngredient: recipe.ingredients.map((x) =>
    [x.amount, x.unit, x.name].filter((v) => v !== null && v !== '').join(' '),
  ),
  recipeInstructions: recipe.steps.map((s) => ({
    '@type': 'HowToStep',
    name: s.title,
    text: s.text,
    ...(s.image ? { image: new URL(s.image, Astro.site).toString() } : {}),
  })),
  ...(recipe.nutrition ? {
    nutrition: {
      '@type': 'NutritionInformation',
      ...(recipe.nutrition.calories !== undefined ? { calories: `${recipe.nutrition.calories} calories` } : {}),
      ...(recipe.nutrition.carbs !== undefined ? { carbohydrateContent: `${recipe.nutrition.carbs} g` } : {}),
      ...(recipe.nutrition.protein !== undefined ? { proteinContent: `${recipe.nutrition.protein} g` } : {}),
      ...(recipe.nutrition.fat !== undefined ? { fatContent: `${recipe.nutrition.fat} g` } : {}),
      ...(recipe.nutrition.fiber !== undefined ? { fiberContent: `${recipe.nutrition.fiber} g` } : {}),
    },
  } : {}),
};
---
<Base title={recipe.title} description={recipe.description} image={recipe.image}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  <div class="container recipe-page">
    <div class="breadcrumb">
      <a href="/">Home</a> › <a href={`/category/${recipe.category}/`}>{categoryName(recipe.category)}</a> › {recipe.title}
    </div>
    <div class="recipe-title">
      <h1>{recipe.title}</h1>
      <p class="recipe-by">Recipe by <strong>JyoCanCook</strong></p>
      <p class="intro">{recipe.description}</p>
      <div class="tags">
        <a class="pill" href={`/category/${recipe.category}/`}>{categoryName(recipe.category)}</a>
        {displayTags.map((tag) => (
          <a class="pill" href={`/tag/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-'))}/`}>{tag}</a>
        ))}
      </div>
      <div class="recipe-actions">
        <button id="save" class="btn btn-outline" type="button" aria-pressed="false">
          <Heart aria-hidden="true" /><span id="save-label">Save</span>
        </button>
        <button id="share" class="btn btn-outline" type="button"><ArrowUpRight aria-hidden="true" />Share</button>
        <button class="btn btn-outline" type="button" onclick="window.print()"><Printer aria-hidden="true" />Print</button>
      </div>
    </div>

    <div class="recipe-layout">
      <div>
        {youtubeEmbedUrl ? (
          <div class="recipe-main-media video-container">
            <iframe
              src={youtubeEmbedUrl}
              title={`How to make ${recipe.title}`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        ) : (
          <img class="recipe-main-image" src={recipe.image} alt={recipe.title} width="800" height="600" />
        )}

        <div class="meta-strip">
          <div class="meta-item">
            <Clock class="meta-icon" aria-hidden="true" />
            <div class="meta-content">
              <span class="meta-label">Prep Time</span>
              <strong class="meta-value">{recipe.prepTime} min</strong>
            </div>
          </div>
          <div class="meta-item">
            <Flame class="meta-icon" aria-hidden="true" />
            <div class="meta-content">
              <span class="meta-label">Cook Time</span>
              <strong class="meta-value">{recipe.cookTime} min</strong>
            </div>
          </div>
          <div class="meta-item">
            <Users class="meta-icon" aria-hidden="true" />
            <div class="meta-content">
              <span class="meta-label">Servings</span>
              <strong class="meta-value">{recipe.servings}</strong>
            </div>
          </div>
          <div class="meta-item">
            <Star class="meta-icon" aria-hidden="true" />
            <div class="meta-content">
              <span class="meta-label">Difficulty</span>
              <strong class="meta-value">{recipe.difficulty}</strong>
            </div>
          </div>
          {recipe.nutrition?.calories !== undefined && (
            <div class="meta-item">
              <Zap class="meta-icon" aria-hidden="true" />
              <div class="meta-content">
                <span class="meta-label">Calories</span>
                <strong class="meta-value">{recipe.nutrition.calories} kcal</strong>
              </div>
            </div>
          )}
        </div>

        {recipe.nutrition && (recipe.nutrition.protein !== undefined || recipe.nutrition.carbs !== undefined || recipe.nutrition.fat !== undefined || recipe.nutrition.fiber !== undefined) && (
          <div class="nutrition-strip">
            <span class="nutrition-label">Nutrition</span>
            <div class="nutrition-items">
              {recipe.nutrition.carbs !== undefined && (
                <div class="nutrition-pill">
                  <span class="nut-name">Carbs</span>
                  <strong class="nut-val">{recipe.nutrition.carbs}g</strong>
                </div>
              )}
              {recipe.nutrition.protein !== undefined && (
                <div class="nutrition-pill">
                  <span class="nut-name">Protein</span>
                  <strong class="nut-val">{recipe.nutrition.protein}g</strong>
                </div>
              )}
              {recipe.nutrition.fiber !== undefined && (
                <div class="nutrition-pill">
                  <span class="nut-name">Fiber</span>
                  <strong class="nut-val">{recipe.nutrition.fiber}g</strong>
                </div>
              )}
              {recipe.nutrition.fat !== undefined && (
                <div class="nutrition-pill">
                  <span class="nut-name">Fat</span>
                  <strong class="nut-val">{recipe.nutrition.fat}g</strong>
                </div>
              )}
            </div>
          </div>
        )}

        {recipe.story && (
          <div class="recipe-story-panel">
            <div class="recipe-story-badge">Story &amp; Background</div>
            <p class="recipe-story-text">{recipe.story}</p>
          </div>
        )}

        <div class="panel">
          <div class="ingredients-head">
            <h2>Ingredients</h2>
            <div class="serving-controls">
              Servings: <strong id="servings">{recipe.servings}</strong>
              <div class="scale-group" role="group" aria-label="Scale recipe">
                <button type="button" class="scale-btn" data-scale="0.5" aria-pressed="false">0.5x</button>
                <button type="button" class="scale-btn active" data-scale="1" aria-pressed="true">1x</button>
                <button type="button" class="scale-btn" data-scale="2" aria-pressed="false">2x</button>
              </div>
            </div>
          </div>
          <div id="ingredients">
            {ingredientSections.map((sec) => (
              <div class="ingredient-section-group">
                {sec.title && <h3 class="ingredient-section-title">{sec.title}</h3>}
                <div class="ingredient-grid">
                  {sec.items.map((i) => (
                    <label class="ingredient">
                      <input type="checkbox" />
                      <span>
                        <span class="qty" data-amount={i.amount ?? ''}>{formatQty(i.amount, true)}</span>
                        {i.unit ? ` ${unitLabel(i.unit)}` : ''} {i.name}
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <section class="steps">
          <h2>How to Make {shortTitle}</h2>
          {displaySteps.map((s, i) => (
            <div class="step">
              <div class="step-num">{i + 1}</div>
              <div class="step-body">
                <div class="step-content">
                  <h3>{s.title}{s.optional && <span class="step-optional">Optional</span>}</h3>
                  {stepBlocks(s.text).map((b) =>
                    b.type === 'ul' ? (
                      <ul>{b.lines.map((l) => <li>{l}</li>)}</ul>
                    ) : b.type === 'ol' ? (
                      <ol>{b.lines.map((l) => <li>{l}</li>)}</ol>
                    ) : (
                      <p>{b.lines.join('\n')}</p>
                    ),
                  )}
                </div>
                {s.image && (
                  <div class="step-image-wrap">
                    <img class="step-image" src={s.image} alt={s.title} loading="lazy" />
                  </div>
                )}
              </div>
            </div>
          ))}
        </section>

        {((recipe.tips?.length ?? 0) > 0 || (recipe.serveWith?.length ?? 0) > 0) && (
          <div class="post-steps-grid">
            {(recipe.tips?.length ?? 0) > 0 && (
              <div class="panel panel-warm">
                <h2><Lightbulb aria-hidden="true" />Pro Tips</h2>
                <ul>{recipe.tips?.map((t) => <li>{t}</li>)}</ul>
              </div>
            )}
            {(recipe.serveWith?.length ?? 0) > 0 && (
              <div class="panel">
                <h2><Utensils aria-hidden="true" />Serve with</h2>
                <p>{recipe.serveWith?.join(' · ')}</p>
              </div>
            )}
          </div>
        )}

      </div>

      <aside>
        {similarRecipes.length > 0 && (
          <div class="panel">
            <h2>You Might Also Like</h2>
            <div class="sidebar-recipe-list">
              {similarRecipes.map((r) => (
                <a class="sidebar-recipe-item" href={`/recipes/${r.slug}/`}>
                  <img class="sidebar-recipe-thumb" src={r.image} alt={r.title} loading="lazy" />
                  <div class="sidebar-recipe-info">
                    <h3>{r.title}</h3>
                    <div class="sidebar-recipe-meta">
                      <span>{categoryName(r.category)}</span>
                      <span>•</span>
                      <span>{r.prepTime + r.cookTime} min</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {latestRecipes.length > 0 && (
          <div class="panel">
            <h2>Latest Recipes</h2>
            <div class="sidebar-recipe-list">
              {latestRecipes.map((r) => (
                <a class="sidebar-recipe-item" href={`/recipes/${r.slug}/`}>
                  <img class="sidebar-recipe-thumb" src={r.image} alt={r.title} loading="lazy" />
                  <div class="sidebar-recipe-info">
                    <h3>{r.title}</h3>
                    <div class="sidebar-recipe-meta">
                      <span>{categoryName(r.category)}</span>
                      <span>•</span>
                      <span>{r.prepTime + r.cookTime} min</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </div>

  <script define:vars={{ slug: recipe.slug, base: recipe.servings }}>
    const output = document.querySelector('#servings');
    // Servings are shown as decimals (2.5), unlike ingredient quantities which use fractions.
    function formatServings(n) {
      return String(Number(n.toFixed(2)));
    }
    function formatQty(n) {
      const whole = Math.floor(n);
      const frac = n - whole;
      if (frac < 0.02) return String(whole);
      if (frac > 0.98) return String(whole + 1);
      const fractions = [[1 / 8, '1/8'], [1 / 4, '1/4'], [1 / 3, '1/3'], [3 / 8, '3/8'], [1 / 2, '1/2'], [5 / 8, '5/8'], [2 / 3, '2/3'], [3 / 4, '3/4'], [7 / 8, '7/8']];
      const hit = fractions.find(([v]) => Math.abs(frac - v) < 0.02);
      if (hit) return (whole ? whole + ' ' : '') + hit[1];
      return String(Number(n.toFixed(2)));
    }
    function setScale(scale) {
      output.textContent = formatServings(base * scale);
      document.querySelectorAll('.qty').forEach((el) => {
        el.textContent = el.dataset.amount === '' ? '' : formatQty(Number(el.dataset.amount) * scale);
      });
      document.querySelectorAll('.scale-btn').forEach((btn) => {
        const on = Number(btn.dataset.scale) === scale;
        btn.classList.toggle('active', on);
        btn.setAttribute('aria-pressed', String(on));
      });
    }
    document.querySelectorAll('.scale-btn').forEach((btn) => {
      btn.onclick = () => setScale(Number(btn.dataset.scale));
    });
    const saved = JSON.parse(localStorage.getItem('jyo-saved') || '[]');
    const save = document.querySelector('#save');
    const saveLabel = document.querySelector('#save-label');
    function showSaved(isSaved) {
      save.setAttribute('aria-pressed', String(isSaved));
      saveLabel.textContent = isSaved ? 'Saved' : 'Save';
    }
    showSaved(saved.includes(slug));
    save.onclick = () => {
      let arr = JSON.parse(localStorage.getItem('jyo-saved') || '[]');
      arr = arr.includes(slug) ? arr.filter((x) => x !== slug) : [...arr, slug];
      localStorage.setItem('jyo-saved', JSON.stringify(arr));
      showSaved(arr.includes(slug));
    };
    document.querySelector('#share').onclick = async () => {
      if (navigator.share) {
        try {
          await navigator.share({ title: document.title, url: location.href });
        } catch {}
      } else {
        await navigator.clipboard.writeText(location.href);
        alert('Recipe link copied');
      }
    };
  </script>
</Base>
