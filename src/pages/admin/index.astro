---
import Base from '../../layouts/Base.astro';
---
<Base title="Recipe Admin" noindex={true}>
  <div class="container admin-layout">
    <aside class="admin-side">
      <button data-tab="recipes" class="selected">Recipes</button>
      <button data-tab="categories">Categories</button>
      <button data-tab="subcategories">Sub Categories</button>
      <button data-tab="diets">Diets</button>
      <button data-tab="tags">Tags</button>
      <button data-tab="menu">Navigation Menu</button>
    </aside>
    <section>
      <div class="section-heading" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <h1 style="font-size:var(--fs-2xl);margin:0;">JyoCanCook Admin</h1>
        <div id="admin-user-bar" style="display:flex;align-items:center;gap:12px;">
          <span id="admin-user-info" class="muted" style="font-size:var(--fs-sm);"></span>
          <button id="btn-rebuild-site" class="btn btn-outline" type="button" style="padding:6px 14px;font-size:var(--fs-xs);">↻ Rebuild All Static Pages</button>
          <a id="btn-logout" href="/api/auth/logout" class="btn btn-outline" style="padding:6px 14px;font-size:var(--fs-xs);">Logout</a>
        </div>
      </div>
      <p class="muted">Manage your recipes, menus, and categories. Published recipes generate live static HTML pages immediately.</p>
      <div id="admin-message" class="admin-message">Checking administrator access...</div>
      <div id="admin-content" class="panel hidden"></div>
    </section>
  </div>
  <script src="../../scripts/admin.ts"></script>
</Base>
