---
import Base from '../layouts/Base.astro';
---
<Base title="Search Recipes"><div class="container section"><span class="eyebrow">Find something delicious</span><h1>Search recipes</h1><form id="search-form" class="search-field" style="max-width:680px"><input id="search-term" placeholder="Try chicken, garlic, rice, dosa..." aria-label="Search recipes"/><button class="btn">Search</button></form><p class="muted" id="search-status" style="margin-top:20px">Search by recipe name, ingredient or cooking method.</p><div id="results" class="cards"></div></div><script>let pagefind:any;const pagefindUrl='/pagefind/pagefind.js';const input=document.querySelector<HTMLInputElement>('#search-term')!;const results=document.querySelector<HTMLElement>('#results')!;const status=document.querySelector<HTMLElement>('#search-status')!;input.value=new URLSearchParams(location.search).get('q')||'';async function run(q:string){if(!q.trim()){results.innerHTML='';status.textContent='Enter something to search for.';return}status.textContent='Searching...';try{pagefind??=await import(/* @vite-ignore */pagefindUrl);const search=await pagefind.search(q);const loaded=await Promise.all(search.results.slice(0,40).map((x:any)=>x.data()));results.innerHTML='';for(const r of loaded){const a=document.createElement('a');a.className='recipe-card';a.href=r.url;const content=document.createElement('div');content.className='recipe-card-content';const h=document.createElement('h3');h.textContent=r.meta?.title||'Recipe';const p=document.createElement('p');p.className='muted';p.textContent=(r.excerpt||'').replace(/<[^>]*>/g,'');content.append(h,p);a.append(content);results.append(a)}status.textContent=`${search.results.length} result(s) for “${q}”`;}catch(e){status.textContent='Search index not available in Astro dev mode. Run npm run build then npm run deploy to test Pagefind.'}}document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();const q=input.value.trim();history.replaceState({},'',q?'/search/?q='+encodeURIComponent(q):'/search/');run(q)});if(input.value)run(input.value);</script></Base>
