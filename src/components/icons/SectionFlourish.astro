---
const { side = 'left', class: className } = Astro.props as { side?: 'left' | 'right'; class?: string };
---
<svg
  class={className}
  style={side === 'right' ? 'transform: scaleX(-1);' : undefined}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <line x1="0" y1="10" x2="60" y2="10" />
  <path d="M60 10 C 70 2, 78 4, 82 10 C 78 16, 70 18, 60 10 Z" />
  <path d="M82 10 C 86 5, 93 6, 96 10 C 93 14, 86 15, 82 10 Z" />
  <circle cx="82" cy="10" r="1.5" fill="currentColor" stroke="none" />
</svg>
