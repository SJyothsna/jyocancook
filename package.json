{
  "name": "jyocancook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "package:staging": "node bin/package-hostinger.mjs --target staging",
    "package:production": "node bin/package-hostinger.mjs --target production",
    "package:production-update": "node bin/package-hostinger.mjs --target production --mode update",
    "check": "astro check",
    "test": "node --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.3.1",
    "@lucide/astro": "^1.73.0",
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@php-wasm/node": "^3.1.65",
    "@php-wasm/universal": "^3.1.65",
    "pagefind": "^1.3.0",
    "typescript": "^5.8.0"
  }
}
