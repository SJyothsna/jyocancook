# JyoCanCook Public Web Root .htaccess for Hostinger (Apache / LiteSpeed)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS first, so no request (including /api/*) is ever handled over plain HTTP
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Route API requests to api/index.php
    RewriteRule ^api(/.*)?$ /api/index.php [QSA,L]

    # 3. Clean trailing slash for directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # 4. Serve index.html if directory exists
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.*)/$ $1/index.html [L]

    # 5. Serve .html if exists without extension
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Unhashed static files (styles/global.css, favicon.svg, images, pagefind runtime, ...):
    # short cache with revalidation. One-year immutable caching is only applied to
    # content-hashed files under /_astro/ (see _astro/.htaccess added by the packager).
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # HTML and XML pages (Revalidate immediately so updates show live)
    <FilesMatch "\.(html|htm|xml|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.html

# Prevent Directory Browsing
Options -Indexes
